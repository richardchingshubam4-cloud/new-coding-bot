<!DOCTYPE html>
<html>
<head>
    <title>Student Attendance Management System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
        }

        table {
            margin: auto;
            border-collapse: collapse;
            width: 70%;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
        }

        th {
            background-color: lightgray;
        }

        input {
            padding: 8px;
            width: 250px;
        }

        button {
            padding: 8px 15px;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
            font-size: 18px;
            color: blue;
        }
    </style>
</head>

<body>

    <h2>Student Attendance Management System</h2>

    <input type="text" id="searchName" placeholder="Enter Student Name">
    <button onclick="searchStudent()">Search</button>

    <p id="result"></p>

    <table>
        <tr>
            <th>Roll No</th>
            <th>Student Name</th>
            <th>Attendance (%)</th>
        </tr>

        <tr><td>1</td><td>Rahul</td><td>85%</td></tr>
        <tr><td>2</td><td>Priya</td><td>90%</td></tr>
        <tr><td>3</td><td>Aman</td><td>78%</td></tr>
        <tr><td>4</td><td>Neha</td><td>88%</td></tr>
        <tr><td>5</td><td>Rohan</td><td>92%</td></tr>
        <tr><td>6</td><td>Anjali</td><td>80%</td></tr>
        <tr><td>7</td><td>Karan</td><td>75%</td></tr>
        <tr><td>8</td><td>Simran</td><td>95%</td></tr>
        <tr><td>9</td><td>Vikram</td><td>70%</td></tr>
        <tr><td>10</td><td>Pooja</td><td>89%</td></tr>
    </table>

    <script>
        const students = {
            "Rahul": "85%",
            "Priya": "90%",
            "Aman": "78%",
            "Neha": "88%",
            "Rohan": "92%",
            "Anjali": "80%",
            "Karan": "75%",
            "Simran": "95%",
            "Vikram": "70%",
            "Pooja": "89%"
        };

        function searchStudent() {
            let name = document.getElementById("searchName").value;

            if (students[name]) {
                document.getElementById("result").innerHTML =
                    "Attendance of " + name + " is " + students[name];
            } else {
                document.getElementById("result").innerHTML =
                    "Student not found!";
            }
        }
    </script>

</body>
</html>
